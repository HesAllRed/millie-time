# Cloudflare Pages header rules.
#
# The no-cache on sw.js is the load-bearing line: the service worker is the file
# that gates every future update, and without header control you are at the
# mercy of the CDN's default TTL on exactly the wrong file. This is why the
# project is hosted here rather than on GitHub Pages.

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/app.css
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Icons were cached for a week, which meant an icon change took up to seven days
# to show in the browser. They are small and fetched rarely, so revalidating
# costs a 304. Note this does nothing for a shortcut already on a home screen:
# iOS snapshots that icon at install time and never looks again.
/icons/*
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()
